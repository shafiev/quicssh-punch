config quicssh-punch 'main'
	option enabled '0'
	option port '44433'
	option role 'A'
	# Long random ntfy.sh topic, shared by both sides. Keep it private.
	option topic ''
	# Server side: local quicssh server to relay to. Empty = client mode.
	option target ''
	# Static peer ip:port, skips the rendezvous (testing).
	option peer ''
	option stun 'stun.l.google.com:19302'
