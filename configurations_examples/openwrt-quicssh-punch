#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/quicssh-punch -port 44433 -role A \
		-topic punch-fXXXX \
		-target 10.144.1.1:4433
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
